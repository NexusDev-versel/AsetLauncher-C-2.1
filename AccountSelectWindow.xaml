<Window x:Class="AsetLauncher.AccountSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор профиля"
        Height="490"
        Width="700"
        MinHeight="450"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#FF121A24">
        <Border Margin="18"
                Background="#FF1C2735"
                CornerRadius="12"
                BorderBrush="#FF36506B"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Аккаунты"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Background="#FF0F1621"
                        BorderBrush="#FF486280"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ListView x:Name="AccountsListView"
                              Margin="6"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="Black"
                              MouseDoubleClick="AccountsListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Никнейм" Width="220" DisplayMemberBinding="{Binding Nickname}" />
                                <GridViewColumn Header="Тип" Width="130" DisplayMemberBinding="{Binding TypeLabel}" />
                                <GridViewColumn Header="UUID" Width="290" DisplayMemberBinding="{Binding Uuid}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="AddAccountButton"
                            Content="+"
                            Height="36"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#FF0B84FF"
                            BorderBrush="#FF56A8FF"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Добавить аккаунт"
                            Click="AddAccountButton_Click" />

                    <Button Grid.Column="2"
                            x:Name="RemoveAccountButton"
                            Content="Удалить"
                            Height="36"
                            Foreground="White"
                            Background="#FF5A3740"
                            BorderBrush="#FFB56D7B"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="RemoveAccountButton_Click" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock"
                               VerticalAlignment="Center"
                               Foreground="#FFD2DCEB"
                               Text="" />

                    <Button Grid.Column="2"
                            x:Name="SelectButton"
                            Content="Выбрать"
                            Height="38"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#FF0BA564"
                            BorderBrush="#FF58CF9A"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="SelectButton_Click" />

                    <Button Grid.Column="4"
                            x:Name="CloseButton"
                            Content="Закрыть"
                            Height="38"
                            FontSize="14"
                            Foreground="White"
                            Background="#FF3F4F64"
                            BorderBrush="#FF7088A7"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="CloseButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

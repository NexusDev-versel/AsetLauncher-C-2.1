<Window x:Class="AsetLauncher.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Профиль пользователя"
        Height="420"
        Width="420"
        MinHeight="390"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="ProfileBackgroundBrush"
                        ImageSource="Assets/main-menu-bg-mc.png"
                        Stretch="UniformToFill" />
        </Grid.Background>

        <Border Background="#AA101824" />

        <Border Margin="22"
                Background="#DD1B2737"
                CornerRadius="14"
                BorderBrush="#FF4A617D"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Профиль пользователя"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <Border Grid.Row="1"
                        Margin="0,18,0,0"
                        Width="112"
                        Height="112"
                        CornerRadius="56"
                        HorizontalAlignment="Center"
                        BorderBrush="#FF7E95B0"
                        BorderThickness="2"
                        Background="#FF0F1621"
                        ClipToBounds="True">
                    <Image x:Name="AvatarImage"
                           Stretch="UniformToFill" />
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="0,14,0,0"
                           Text="Никнейм"
                           Foreground="#FFD8E5F6"
                           FontSize="14"
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Row="3"
                           x:Name="NicknameTextBlock"
                           Margin="0,3,0,0"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Row="4"
                           x:Name="AccountTypeTextBlock"
                           Margin="0,8,0,0"
                           Foreground="#FFC2D4EA"
                           FontSize="13"
                           HorizontalAlignment="Center" />

                <Button Grid.Row="5"
                        x:Name="ChooseProfileButton"
                        Content="Выбрать профиль"
                        Width="190"
                        Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#FF0B84FF"
                        BorderBrush="#FF56A8FF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ChooseProfileButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

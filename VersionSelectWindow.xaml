<Window x:Class="AsetLauncher.VersionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор версии"
        Height="430"
        Width="560"
        MinHeight="390"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="VersionWindowBackgroundBrush"
                        ImageSource="Assets/main-menu-bg-mc.png"
                        Stretch="UniformToFill" />
        </Grid.Background>

        <Border Background="#C40E141E" />

        <Border Margin="24"
                Background="#E616202D"
                CornerRadius="16"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Выбор версии Minecraft"
                           Foreground="#FFF8FAFF"
                           FontSize="24"
                           Padding="100,0,0,0"
                           FontWeight="SemiBold" />

                <Grid Grid.Row="1"
                      Margin="0,12,0,12"
                      Width="200"
                      Height="30"
                      HorizontalAlignment="Center">
                    <TextBox x:Name="SearchTextBox"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Background="White"
                             Foreground="Black"
                             BorderBrush="#FF2A3D56"
                             BorderThickness="1"
                             Padding="8,0,8,0"
                             TextChanged="SearchTextBox_TextChanged" />
                    <TextBlock Text="Поиск версий"
                               Margin="10,0,0,0"
                               Foreground="#FF8D95A0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Row="2"
                          x:Name="VersionComboBox"
                          Width="200"
                          Height="32"
                          FontSize="13"
                          MaxDropDownHeight="220"
                          HorizontalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Background="White"
                          Foreground="Black"
                          BorderBrush="#FF2A3D56"
                          BorderThickness="1">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="8,2" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Button Grid.Row="3"
                        x:Name="InstalledFilterButton"
                        Content="Показать установленные"
                        Width="200"
                        Height="30"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="White"
                        Background="#FF3A4D66"
                        BorderBrush="#FF5C7292"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="InstalledFilterButton_Click" />

                <Button Grid.Row="4"
                        x:Name="LaunchButton"
                        Content="Запустить"
                        Width="140"
                        Height="34"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#FF0B84FF"
                        BorderBrush="#FF56A8FF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="LaunchButton_Click" />

                <TextBlock Grid.Row="5"
                           x:Name="StatusTextBlock"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FFE5ECF8"
                           FontSize="13"
                           Text="" />

                <ProgressBar Grid.Row="6"
                             x:Name="BusyProgressBar"
                             Margin="0,10,0,0"
                             Width="240"
                             Height="6"
                             HorizontalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>


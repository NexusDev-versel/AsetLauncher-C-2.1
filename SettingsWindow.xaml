<Window x:Class="AsetLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройки лаунчера"
        Height="470"
        Width="760"
        MinHeight="430"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FF121A24">
        <Border Margin="18"
                Background="#FF1C2735"
                CornerRadius="12"
                BorderBrush="#FF36506B"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Настройки"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#FF172230"
                            CornerRadius="10"
                            BorderBrush="#FF31485F"
                            BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="Разделы"
                                       Foreground="#FFD3E3F7"
                                       FontSize="13"
                                       Margin="6,0,6,10" />

                            <Button x:Name="LauncherPageButton"
                                    Content="Настройки лаунчера"
                                    Height="38"
                                    Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0,0,0"
                                    Foreground="White"
                                    Background="#FF2D4E74"
                                    BorderBrush="#1F5EA3"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="LauncherPageButton_Click" />

                            <Button x:Name="MinecraftPageButton"
                                    Content="Майнкрафт"
                                    Height="38"
                                    Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0,0,0"
                                    Foreground="White"
                                    Background="#FF233245"
                                    BorderBrush="#1F5EA3"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="MinecraftPageButton_Click" />

                            <Button x:Name="ServersPageButton"
                                    Content="Сервера"
                                    Height="38"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0,0,0"
                                    Foreground="White"
                                    Background="#FF233245"
                                    BorderBrush="#1F5EA3"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ServersPageButton_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Border x:Name="LauncherPagePanel"
                                Background="#FF172230"
                                CornerRadius="10"
                                BorderBrush="#FF31485F"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <StackPanel>
                                    <TextBlock Text="Настройки лаунчера"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="SemiBold" />

                                    <TextBlock Margin="0,10,0,0"
                                               Text="Общие параметры интерфейса и служебные инструменты."
                                               Foreground="#FFD2DCEB"
                                               FontSize="13" />

                                    <TextBlock Margin="0,14,0,6"
                                               Text="Тема лаунчера"
                                               Foreground="#FFDCE7F5"
                                               FontSize="14" />

                                    <ComboBox x:Name="ThemeComboBox"
                                              Width="250"
                                              Height="30"
                                              HorizontalAlignment="Left"
                                              FontSize="14"
                                              VerticalContentAlignment="Center"
                                              Background="Black"
                                              Foreground="Black"
                                              BorderBrush="#FF486280"
                                              BorderThickness="1" />

                                    <TextBlock Margin="0,14,0,6"
                                               Text="Треки"
                                               Foreground="#FFDCE7F5"
                                               FontSize="14" />

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ComboBox x:Name="TrackComboBox"
                                                  Grid.Row="0"
                                                  Height="30"
                                                  Margin="0,0,0,8"
                                                  HorizontalAlignment="Stretch"
                                                  FontSize="14"
                                                  VerticalContentAlignment="Center"
                                                  Background="White"
                                                  Foreground="Black"
                                                  BorderBrush="#FF486280"
                                                  BorderThickness="1"
                                                  DropDownOpened="TrackComboBox_DropDownOpened"
                                                  SelectionChanged="TrackComboBox_SelectionChanged">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="Black" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="MusicToggleButton"
                                                    Grid.Column="0"
                                                    Height="30"
                                                    Content="Музыка: Вкл"
                                                    Foreground="White"
                                                    Background="#FF2D4E74"
                                                    BorderBrush="#FF5588BF"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    Click="MusicToggleButton_Click" />

                                            <Slider x:Name="MusicVolumeSlider"
                                                    Grid.Column="2"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="False"
                                                    ValueChanged="MusicVolumeSlider_ValueChanged" />

                                            <TextBlock x:Name="MusicVolumeTextBlock"
                                                       Grid.Column="4"
                                                       VerticalAlignment="Center"
                                                       Foreground="#FFD6E8FF"
                                                       FontSize="12"
                                                       Text="35%" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock x:Name="MusicHintTextBlock"
                                               Margin="0,8,0,0"
                                               Foreground="#FFA6BCD4"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="Треки берутся из папки Assets/Sounds. Поддерживаются MP3." />

                                    <TextBlock x:Name="SettingsPathTextBlock"
                                               Margin="0,14,0,0"
                                               Foreground="#FFA6BCD4"
                                               FontSize="12"
                                               TextWrapping="Wrap" />

                                    <Button Content="Открыть консоль"
                                            Width="170"
                                            Height="36"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            FontSize="14"
                                            Foreground="White"
                                            Background="#FF2D4E74"
                                            BorderBrush="#FF5588BF"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Click="ConsoleButton_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="MinecraftPagePanel"
                                Visibility="Collapsed"
                                Background="#FF172230"
                                CornerRadius="10"
                                BorderBrush="#FF31485F"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Настройки Minecraft"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Text="Управление памятью и фильтрацией доступных версий."
                                               Foreground="#FFD2DCEB"
                                               FontSize="13" />

                                    <Border Grid.Row="2"
                                            Margin="0,14,0,0"
                                            Background="#EE0F1621"
                                            CornerRadius="10"
                                            BorderBrush="#FF3E5773"
                                            BorderThickness="1"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Оперативная память"
                                                           Foreground="#FFEAF3FF"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="Укажите количество памяти в ГБ."
                                                           Foreground="#FFB8C9DE"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBox x:Name="RamGbTextBox"
                                                         Width="88"
                                                         Height="34"
                                                         FontSize="16"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Background="#FF0A1018"
                                                         Foreground="White"
                                                         BorderBrush="#FF4F6C8D"
                                                         BorderThickness="1" />
                                                <TextBlock Text="ГБ"
                                                           Margin="8,0,0,0"
                                                           Foreground="#FFD6E8FF"
                                                           FontSize="14"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="3"
                                                Margin="0,14,0,0">
                                        <TextBlock Text="Видимость версий"
                                                   Foreground="#FFEAF3FF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />

                                        <CheckBox x:Name="SnapshotsCheckBox"
                                                  Margin="0,10,0,0"
                                                  Content="Показывать snapshot-версии Minecraft"
                                                  Foreground="#FFE9F1FD"
                                                  FontSize="14" />

                                        <CheckBox x:Name="ShowFabricCheckBox"
                                                  Margin="0,8,0,0"
                                                  Content="Показывать Fabric версии"
                                                  Foreground="#FFE9F1FD"
                                                  FontSize="14" />

                                        <CheckBox x:Name="ShowForgeCheckBox"
                                                  Margin="0,8,0,0"
                                                  Content="Показывать Forge версии"
                                                  Foreground="#FFE9F1FD"
                                                  FontSize="14" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="ServersPagePanel"
                                Visibility="Collapsed"
                                Background="#FF172230"
                                CornerRadius="10"
                                BorderBrush="#FF31485F"
                                BorderThickness="1"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <StackPanel>
                                    <TextBlock Text="Сервера"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="SemiBold" />

                                    <StackPanel Margin="0,12,0,0">
                                        <Border Background="#EE0F1621"
                                                CornerRadius="10"
                                                BorderBrush="#FF3E5773"
                                                BorderThickness="1"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Локальные серверы Minecraft"
                                                           Foreground="#FFEAF3FF"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />

                                                <TextBlock Margin="0,8,0,0"
                                                           Text="Создание серверов с полной установкой ядра, версиями из официальных источников и отдельным окном управления."
                                                           Foreground="#FFB8C9DE"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />

                                                <Button Content="Открыть менеджер серверов"
                                                        Width="250"
                                                        Height="38"
                                                        Margin="0,12,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="14"
                                                        Foreground="White"
                                                        Background="#FF2D4E74"
                                                        BorderBrush="#FF5588BF"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Click="OpenServerManagerButton_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,10,0,0"
                                                Background="#EE0F1621"
                                                CornerRadius="10"
                                                BorderBrush="#FF3E5773"
                                                BorderThickness="1"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Возможности раздела"
                                                           Foreground="#FFEAF3FF"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Margin="0,10,0,0"
                                                           Text="• Консоль сервера с командами в реальном времени"
                                                           Foreground="#FFB8C9DE"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="• Файловый менеджер внутри лаунчера"
                                                           Foreground="#FFB8C9DE"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="• Гибкие настройки Java и оперативной памяти"
                                                           Foreground="#FFB8C9DE"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="2"
                            Content="Сохранить"
                            Height="40"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#FF0BA564"
                            BorderBrush="#FF58CF9A"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="SaveButton_Click" />

                    <Button Grid.Column="4"
                            Content="Отмена"
                            Height="40"
                            FontSize="15"
                            Foreground="White"
                            Background="#FF3F4F64"
                            BorderBrush="#FF7088A7"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="CancelButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

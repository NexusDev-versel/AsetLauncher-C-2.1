<Window x:Class="AsetLauncher.ServerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер серверов"
        Height="700"
        Width="1160"
        MinHeight="620"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C1624" Offset="0" />
            <GradientStop Color="#0E1C2F" Offset="0.5" />
            <GradientStop Color="#122741" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBrush" Color="#141F2E" />
        <SolidColorBrush x:Key="CardBrush" Color="#0E1724" />
        <SolidColorBrush x:Key="BorderBrush" Color="#35516D" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2A547E" />
            <Setter Property="BorderBrush" Value="#6298D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.93" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#0D9963" />
            <Setter Property="BorderBrush" Value="#55CF99" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#6B3D46" />
            <Setter Property="BorderBrush" Value="#BE7B88" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2C3C50" />
            <Setter Property="BorderBrush" Value="#56708F" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#08111C" />
            <Setter Property="Foreground" Value="#ECF5FF" />
            <Setter Property="BorderBrush" Value="#4A6A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#4A6A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#1A2C43" />
            <Setter Property="Foreground" Value="#E8F3FF" />
            <Setter Property="BorderBrush" Value="#40607E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Border Margin="16"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                CornerRadius="18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Локальные серверы Minecraft"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               Text="Создание, установка и управление сервером в одном окне."
                               Foreground="#AFC7E3"
                               FontSize="13" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Создание сервера"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,14,0,6"
                                       Text="Название"
                                       Foreground="#D5E8FF" />
                            <TextBox x:Name="ServerCreateNameTextBox"
                                     Grid.Row="1"
                                     Margin="0,28,0,0"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource InputTextBoxStyle}" />

                            <TextBlock Grid.Row="2"
                                       Margin="0,14,0,6"
                                       Text="Ядро"
                                       Foreground="#D5E8FF" />
                            <ComboBox x:Name="ServerCreateCoreComboBox"
                                      Grid.Row="2"
                                      Margin="0,28,0,0"
                                      Height="34"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="ServerCreateCoreComboBox_SelectionChanged" />

                            <TextBlock Grid.Row="3"
                                       Margin="0,14,0,6"
                                       Text="Доступная версия"
                                       Foreground="#D5E8FF" />
                            <ComboBox x:Name="ServerCreateVersionComboBox"
                                      Grid.Row="3"
                                      Margin="0,28,0,0"
                                      Height="34"
                                      Style="{StaticResource InputComboBoxStyle}" />

                            <TextBlock x:Name="VersionLoadingTextBlock"
                                       Grid.Row="4"
                                       Margin="0,12,0,0"
                                       Foreground="#A9CAE9"
                                       FontSize="12" />

                            <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                                <Button x:Name="CreateServerButton"
                                        Height="38"
                                        Margin="0,14,0,0"
                                        Content="Создать и установить"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Click="CreateServerButton_Click" />

                                <TextBlock x:Name="ServerCreateStatusTextBlock"
                                           Margin="0,10,0,0"
                                           Foreground="#B7D9FF"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="14"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Список серверов"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="SemiBold" />

                            <ListView x:Name="ServersListView"
                                      Grid.Row="1"
                                      Margin="0,10,0,10"
                                      Background="#08111C"
                                      Foreground="White"
                                      BorderBrush="#446789"
                                      BorderThickness="1"
                                      MouseDoubleClick="ServersListView_MouseDoubleClick"
                                      SelectionChanged="ServersListView_SelectionChanged">
                                <ListView.Resources>
                                    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridHeaderStyle}" />
                                    <Style TargetType="{x:Type ListViewItem}">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Foreground" Value="#ECF5FF" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="Black" />
                                                <Setter Property="Background" Value="#DCEAF8" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="Black" />
                                                <Setter Property="Background" Value="#BFD9F3" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Ядро" Width="130" DisplayMemberBinding="{Binding Core}" />
                                        <GridViewColumn Header="Версия" Width="170" DisplayMemberBinding="{Binding Version}" />
                                        <GridViewColumn Header="Папка" Width="340" DisplayMemberBinding="{Binding FolderPath}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="115" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="OpenSelectedServerButton"
                                        Grid.Column="0"
                                        Height="34"
                                        Content="Открыть управление"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OpenSelectedServerButton_Click" />

                                <Button x:Name="RefreshServersButton"
                                        Grid.Column="2"
                                        Height="34"
                                        Content="Обновить"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshServersButton_Click" />

                                <Button x:Name="DeleteServerButton"
                                        Grid.Column="4"
                                        Height="34"
                                        Content="Удалить"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteServerButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

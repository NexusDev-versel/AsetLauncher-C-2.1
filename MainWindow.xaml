<Window x:Class="AsetLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AsetLauncher 2.1"
        Height="560"
        Width="980"
        MinHeight="500"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid x:Name="MainRootGrid">
        <Grid.Background>
            <ImageBrush ImageSource="Assets/main-menu-bg-mc.png" Stretch="UniformToFill" />
        </Grid.Background>

        <Border Background="#220C1220" />

        <Grid Margin="10">
            <Border x:Name="LaunchProgressContainer"
                    Width="280"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Padding="12,10"
                    Background="#D9152131"
                    BorderBrush="#FF4A6380"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Загрузка Minecraft"
                               Foreground="#FFF2F7FF"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="LaunchProgressStatusText"
                               Margin="0,5,0,0"
                               Foreground="#FFDCE8F7"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Text="Подготовка..." />
                    <ProgressBar x:Name="LaunchProgressBar"
                                 Margin="0,8,0,0"
                                 Height="9"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#FF223245"
                                 Foreground="#FF08B978"
                                 BorderBrush="#FF3A5674"
                                 BorderThickness="1"
                                 IsIndeterminate="True" />
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="1,8,0,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="50"
                            Height="50"
                            CornerRadius="10"
                            Background="#A6263649"
                            BorderBrush="#FF7D93AF"
                            BorderThickness="1">
                        <Image x:Name="LauncherLogoImage"
                               Source="Assets/logo.png"
                               Width="45"
                               Height="45"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="AsetLauncher"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FFF2F7FF"
                               FontSize="40"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Grid Margin="10,14,0,0">
                    <Button x:Name="MenuToggleButton"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#C42A3547"
                            BorderBrush="#FF6C84A3"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="MenuToggleButton_Click"
                            ToolTip="Показать/скрыть меню">
                        <Viewbox Width="16" Height="16">
                            <Path Stroke="White"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 4 2 L 12 8 L 4 14">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="MenuArrowRotate" CenterX="8" CenterY="8" />
                                </Path.RenderTransform>
                            </Path>
                        </Viewbox>
                    </Button>

                    <Border x:Name="SlideMenuPanel"
                            Width="56"
                            Height="300"
                            Margin="-10,50,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A6273648"
                            CornerRadius="28"
                            BorderBrush="#B38CA3BF"
                            BorderThickness="1"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SlideMenuTransform" X="-170" />
                        </Border.RenderTransform>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,5">
                            <Button Width="34"
                                    Height="34"
                                    Margin="0,0,0,140"
                                    Background="#4034475E"
                                    BorderBrush="#FF8CA8C8"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Профиль пользователя"
                                    Click="ProfileButton_Click">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White"
                                          Data="M12,12A5,5 0 1,0 12,2A5,5 0 0,0 12,12M12,14C7.58,14 4,16.24 4,19V22H20V19C20,16.24 16.42,14 12,14Z" />
                                </Viewbox>
                            </Button>

                            <Button Width="34"
                                    Height="34"
                                    Margin="0,0,0,6"
                                    Background="#4034475E"
                                    BorderBrush="#FF8CA8C8"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Папка Minecraft"
                                    Click="OpenMinecraftFolderButton_Click">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White"
                                          Data="M10,4L12,6H20C21.1,6 22,6.9 22,8V18C22,19.1 21.1,20 20,20H4C2.9,20 2,19.1 2,18V6C2,4.9 2.9,4 4,4H10Z" />
                                </Viewbox>
                            </Button>

                            <Button Width="34"
                                    Height="34"
                                    Margin="0,0,0,6"
                                    Background="#4034475E"
                                    BorderBrush="#FF8CA8C8"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Настройки лаунчера"
                                    Click="LauncherSettingsButton_Click">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White"
                                          Data="M12,8.6A3.4,3.4 0 1,0 15.4,12A3.4,3.4 0 0,0 12,8.6M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.35 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Button x:Name="PlayButton"
                    Content="Играть"
                    Width="190"
                    Height="54"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#FF00A56A"
                    BorderBrush="#FF07CF88"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="PlayButton_Click" />

            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Margin="8,0,0,8">
                <Button Width="40"
                        Height="40"
                        Margin="0,0,8,0"
                        Background="#C42A3547"
                        BorderBrush="#FF6C84A3"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Discord"
                        Click="DiscordButton_Click">
                    <Image Source="Assets/discord-icon.png"
                           Width="20"
                           Height="20"
                           Stretch="Uniform" />
                </Button>

                <Button Width="40"
                        Height="40"
                        Background="#C42A3547"
                        BorderBrush="#FF6C84A3"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Telegram"
                        Click="TelegramButton_Click">
                    <Image Source="Assets/telegram-icon.png"
                           Width="20"
                           Height="20"
                           Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
